# ============================================
# PERFORMANCE TIPS
# ============================================

# List comprehensions are compiled to efficient bytecode
# They're as fast as manual loops but more readable

# Instead of:
# let result = []
# for x in numbers {
#     if x > 5 {
#         result.push!(x * 2)
#     }
# }

# Use:
let result = [x * 2 for x in numbers if x > 5]

# Both produce the same result, but comprehension is clearer!
