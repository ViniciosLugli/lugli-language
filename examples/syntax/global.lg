# Global Scope Examples
# Demonstrates global variables, functions, and utilities

# Global constants
const APP_NAME = "Lugli Language"
const VERSION = "2.0.0"
const DEBUG_MODE = true

# Global variables
mut global_counter = 0
mut application_state = "initialized"

# Global type definitions
struct GlobalConfig {
    name: str,
    version: str,
    debug: bool
}

enum LogLevel {
    Debug,
    Info,
    Warning,
    Error
}

# Global configuration instance
let GLOBAL_CONFIG = GlobalConfig {
    name: APP_NAME,
    version: VERSION,
    debug: DEBUG_MODE
}

# Global utility functions
fn print_inline(message: str) {
    # Print without newline (equivalent to old print!)
    print(message, end="")
}

fn print_separator() {
    print(" - - -")
}

fn increment_global_counter!() {
    global_counter += 1
}

fn get_global_counter() -> i32 {
    return global_counter
}

fn set_application_state!(state: str) {
    application_state = state
    if DEBUG_MODE {
        print(f"App state changed to: {state}")
    }
}

# Global type inspection utilities
fn get_type_name(value: any) -> str {
    return typeof(value)
}

fn print_type_info(value: any) {
    let type_name = get_type_name(value)
    print(f"Value: {value}, Type: {type_name}")
}

# Testing global functionality
print("=== Global Scope Demonstration ===")
print()

print(f"Application: {APP_NAME} v{VERSION}")
print(f"Debug mode: {DEBUG_MODE}")
print()

# Test inline printing
print_inline("testing not breaking line")
print_separator()
print()

# Test global counter
print(f"Initial counter: {get_global_counter()}")
increment_global_counter!()
increment_global_counter!()
increment_global_counter!()
print(f"After increments: {get_global_counter()}")

# Test application state
print(f"Current state: {application_state}")
set_application_state!("running")
set_application_state!("processing")

# Test type inspection
struct TestStruct {
    field: str
}

let test_values = [
    "hello",
    42,
    3.14,
    true,
    [1, 2, 3],
    {"key": "value"},
    TestStruct { field: "test" },
    null
]

print()
print("=== Type Inspection ===")
for value in test_values {
    print_type_info(value)
}

# Global error handling
try {
    let result = 10 / 0  # This will cause an error
} catch Exception as e {
    print(f"Global error handler caught: {e}")
}

# Global cleanup function
fn cleanup_globals!() {
    global_counter = 0
    application_state = "shutdown"
    print("Global state cleaned up")
}

# Global helper macros (conceptual)
macro_rules! debug_log {
    ($msg:expr) => {
        if DEBUG_MODE {
            print(f"[DEBUG] {$msg}")
        }
    }
}

# Usage of global macro
debug_log!("This is a debug message")

# Global environment information
print()
print("=== Environment Information ===")
print(f"Platform: {env.platform()}")
print(f"Architecture: {env.arch()}")
print(f"Working directory: {env.cwd()}")

# Demonstrate global imports
import math
import os
import sys

print(f"Pi from global math: {math.PI}")
print(f"Current time: {time.now()}")

# Global registry pattern
struct GlobalRegistry {
    items: {str: any}
}

impl GlobalRegistry {
    fn new() -> GlobalRegistry {
        return GlobalRegistry { items: {} }
    }

    fn register!(mut self, name: str, value: any) {
        self.items[name] = value
    }

    fn get(self, name: str) -> Option<any> {
        return self.items.get(name)
    }

    fn list_registered(self) -> [str] {
        return self.items.keys()
    }
}

# Global registry instance
mut GLOBAL_REGISTRY = GlobalRegistry::new()

# Register some global items
GLOBAL_REGISTRY.register!("config", GLOBAL_CONFIG)
GLOBAL_REGISTRY.register!("counter", global_counter)
GLOBAL_REGISTRY.register!("version", VERSION)

print()
print("=== Global Registry ===")
print(f"Registered items: {GLOBAL_REGISTRY.list_registered()}")

for item_name in GLOBAL_REGISTRY.list_registered() {
    match GLOBAL_REGISTRY.get(item_name) {
        Some(value) => print(f"{item_name}: {value}"),
        None => print(f"{item_name}: not found")
    }
}

# Cleanup at end
cleanup_globals!()

print()
print("Global scope demonstration complete!")