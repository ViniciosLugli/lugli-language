# Dynamic imports (runtime)
fn load_plugin(name: str) -> Option<Module> {
    let module_path = f"./plugins/{name}.lg"
    if file_exists(module_path) {
        return Some(import_dynamic(module_path))
    } else {
        return None
    }
}

# Using dynamic imports
if let Some(plugin) = load_plugin("example_plugin") {
    plugin.initialize()
    plugin.execute()
}

# Module testing
# File: tests/string_utils_test.lg
import "../string_utils"
import testing

test "reverse_string should reverse input" {
    let input = "hello"
    let expected = "olleh"
    let actual = string_utils.reverse_string(input)
    assert_eq(expected, actual)
}

test "word_count should count words correctly" {
    let input = "hello world test"
    let expected = 3
    let actual = string_utils.word_count(input)
    assert_eq(expected, actual)
}

# Running tests
# lugli test string_utils_test.lg