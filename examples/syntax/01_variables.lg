# Modern Variable Declaration Examples
# Demonstrates Python+Rust hybrid syntax

# Immutable variables (default)
let name = "Alice"
let age = 25
let pi = 3.14159

# Mutable variables
mut count = 0
mut items = []
mut total = 0.0

# Constants (compile-time evaluated)
const MAX_SIZE = 1000
const APP_VERSION = "1.0.0"
const DEFAULT_TIMEOUT = 30

# Type annotations (optional but recommended)
let score: f64 = 95.5
mut username: str = "user123"
let is_active: bool = true

# String interpolation (Python f-string style)
let greeting = f"Hello, {name}! You are {age} years old."
let status = f"Score: {score}/100"

# List and dict literals
let numbers = [1, 2, 3, 4, 5]
let person = {
    "name": name,
    "age": age,
    "active": is_active
}

# Assignment operators
mut x = 10
x += 5
x -= 3
x *= 2
x /= 4
x %= 3

print(greeting)
print(status)
print(f"Final x value: {x}")
print(f"Person: {person}")
