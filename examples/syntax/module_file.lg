# Module File Example
# Demonstrates module exports and public interfaces

# Export a simple struct
export struct Person {
    name: str,
    age: i32
}

# Export implementation with methods
export impl Person {
    fn new(name: str, age: i32) -> Person {
        return Person { name: name, age: age }
    }

    fn say(self, message: str) {
        print(f"{self.name}: {message}")
    }

    fn introduce(self) {
        print(f"Hi, I'm {self.name} and I'm {self.age} years old.")
    }

    fn greet(self, other_name: str) {
        print(f"{self.name} says hello to {other_name}!")
    }
}

# Export utility functions
export fn create_default_person() -> Person {
    return Person::new("Anonymous", 0)
}

export fn greet_multiple(people: [Person], message: str) {
    for person in people {
        person.say(message)
    }
}

# Export constants
export const DEFAULT_AGE = 18
export const MAX_NAME_LENGTH = 100

# Private helper function (not exported)
fn validate_name(name: str) -> bool {
    return !name.is_empty() && name.len() <= MAX_NAME_LENGTH
}

# Export enum
export enum PersonType {
    Student,
    Teacher,
    Employee,
    Visitor
}

# Re-export from another module (if it existed)
# export { SomeType } from "./other_module"