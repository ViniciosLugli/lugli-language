# Hangman Game - Modern Lugli Syntax
# Demonstrates a complete game implementation using Python+Rust hybrid syntax

struct Hangman {
    word: str,
    founded: [str]
}

impl Hangman {
    fn new(word: str) -> Hangman {
        return Hangman {
            word: word,
            founded: []
        }
    }

    fn setup!(mut self) {
        for _ in range(self.word.len()) {
            self.founded.push("_")
        }
    }

    fn check_win(self) -> bool {
        let buf = self.founded.join("")
        return buf == self.word
    }

    fn check_letter!(mut self, letter: str) -> bool {
        let mut found = false

        for (i, char) in enumerate(self.word.chars()) {
            if char == letter {
                if self.founded[i] == "_" {
                    self.founded[i] = letter
                    found = true
                }
            }
        }

        print(f"Current progress: {self.founded.join(' ')}")
        return found
    }

    fn get_progress(self) -> [str] {
        return self.founded
    }

    fn is_complete(self) -> bool {
        return !self.founded.contains("_")
    }

    fn display_word(self) {
        print(f"Word: {self.founded.join(' ')}")
    }
}

# Game logic
print("🎮 Welcome to Hangman!")
print("Try to guess the word letter by letter.")
print()

let mut hangman = Hangman::new("lugli")
hangman.setup!()

mut attempts = 0
mut wrong_letters = []
const MAX_ATTEMPTS = 6

print("Let's start!")
hangman.display_word()
print()

loop {
    print(f"Attempts remaining: {MAX_ATTEMPTS - attempts}")
    if !wrong_letters.is_empty() {
        print(f"Wrong letters: {wrong_letters.join(', ')}")
    }

    let letter = input("Enter a letter: ").trim().lower()

    # Validate input
    if letter.len() != 1 {
        print("Please enter exactly one letter!")
        continue
    }

    if !letter.is_alphabetic() {
        print("Please enter a valid letter!")
        continue
    }

    # Check if already guessed
    if hangman.get_progress().contains(letter) || wrong_letters.contains(letter) {
        print(f"You already guessed '{letter}'!")
        continue
    }

    # Check the letter
    if hangman.check_letter!(letter) {
        print(f"✅ Good guess! The letter '{letter}' is in the word.")

        if hangman.is_complete() {
            print()
            print("🎉 Congratulations! You won!")
            print(f"The word was: {hangman.word}")
            break
        }
    } else {
        print(f"❌ Sorry, the letter '{letter}' is not in the word.")
        wrong_letters.push(letter)
        attempts += 1

        if attempts >= MAX_ATTEMPTS {
            print()
            print("💀 Game Over! You ran out of attempts.")
            print(f"The word was: {hangman.word}")
            break
        }
    }

    print()
    hangman.display_word()
    print()
}

print("Thanks for playing Hangman! 🎮")