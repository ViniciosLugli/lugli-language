# Nested loops benchmark
fn nested_computation(n) {
    mut sum = 0
    mut i = 0
    while i < n {
        mut j = 0
        while j < n {
            mut k = 0
            while k < 10 {
                sum = sum + (i * j + k)
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return sum
}

# Benchmark target
nested_computation(50)
