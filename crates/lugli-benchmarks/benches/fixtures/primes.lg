# Prime number generation using Sieve of Eratosthenes
fn is_prime(n) {
    if n < 2 {
        return false
    }
    if n == 2 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    mut i = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 2
    }
    return true
}

fn find_primes(limit) {
    let primes = []
    mut n = 2
    while n <= limit {
        if is_prime(n) {
            primes.push(n)
        }
        n = n + 1
    }
    return primes
}

# Benchmark target
find_primes(1000)
